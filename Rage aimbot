local function makeSlider(parent, yPos, labelText, minVal, maxVal, currentVal, step, onChanged, onRelease)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 22)
    row.Position = UDim2.new(0, 4, 0, yPos)
    row.BackgroundTransparency = 1
    row.ZIndex = 1000001
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -30, 0, 10)
    label.Position = UDim2.new(0, 2, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = PINK.TEXT
    label.TextSize = 7
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 1000002
    label.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 32, 0, 10)
    valueLabel.Position = UDim2.new(1, -32, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(currentVal)
    valueLabel.TextColor3 = PINK.ACCENT
    valueLabel.TextSize = 7
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 1000002
    valueLabel.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -4, 0, 5)
    track.Position = UDim2.new(0, 2, 0, 13)
    track.BackgroundColor3 = PINK.TRACK
    track.BorderSizePixel = 0
    track.ZIndex = 1000002
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((currentVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = PINK.ACCENT
    fill.BorderSizePixel = 0
    fill.ZIndex = 1000003
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("Frame")
    handle.Size = UDim2.new(0, 10, 0, 10)
    handle.Position = UDim2.new((currentVal - minVal) / (maxVal - minVal), -5, 0.5, -5)
    handle.BackgroundColor3 = PINK.HANDLE
    handle.BorderSizePixel = 0
    handle.ZIndex = 1000004
    handle.Parent = track
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", handle).Color = Color3.new(1,1,1)
    Instance.new("UIStroke", handle).Thickness = 1.5

    local value = currentVal
    local dragging = false

    local function updateValue(inputX)
        local relX = (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X
        relX = math.clamp(relX, 0, 1)
        local val = minVal + (maxVal - minVal) * relX
        val = math.floor(val / step + 0.5) * step
        val = math.clamp(val, minVal, maxVal)
        value = val

        local pos = (val - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        handle.Position = UDim2.new(pos, -5, 0.5, -5)

        if step >= 1 then
            valueLabel.Text = tostring(math.floor(val))
        else
            valueLabel.Text = string.format("%.1f", val)
        end

        onChanged(val)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateValue(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateValue(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragging then
                dragging = false
                saveConfig()
                if onRelease then onRelease(value) end
            end
        end
    end)
end

