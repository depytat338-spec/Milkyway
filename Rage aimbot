local CONFIG_FILE = "spinbot_config.json"

local function saveConfig()
    local json = "{"
    json = json .. '"SKIN_ID":' .. tostring(CONFIG.SKIN_ID) .. ","
    json = json .. '"SKIN_SCALE":' .. tostring(CONFIG.SKIN_SCALE) .. ","
    json = json .. '"SKIN_Y_OFFSET":' .. tostring(CONFIG.SKIN_Y_OFFSET) .. ","
    json = json .. '"TARGET_DISTANCE":' .. tostring(CONFIG.TARGET_DISTANCE) .. ","
    json = json .. '"SPIN_SPEED":' .. tostring(CONFIG.SPIN_SPEED)
    json = json .. "}"

    pcall(function()
        if writefile then writefile(CONFIG_FILE, json) end
    end)
end

local function loadConfig()
    pcall(function()
        if not readfile or not isfile then return end
        if not isfile(CONFIG_FILE) then return end

        local content = readfile(CONFIG_FILE)
        local function extract(key)
            return tonumber(content:match('"' .. key .. '":([%d%.%-]+)'))
        end

        local id = extract("SKIN_ID"); if id then CONFIG.SKIN_ID = id end
        local scale = extract("SKIN_SCALE"); if scale then CONFIG.SKIN_SCALE = scale end
        local yoff = extract("SKIN_Y_OFFSET"); if yoff then CONFIG.SKIN_Y_OFFSET = yoff end
        local dist = extract("TARGET_DISTANCE"); if dist then CONFIG.TARGET_DISTANCE = dist end
        local spin = extract("SPIN_SPEED"); if spin then CONFIG.SPIN_SPEED = spin end

        print("[Config] Настройки загружены")
    end)
end

