local function SetValue(Value)
Value = tonumber(Value) or 1
Value = math.clamp(Value, 1, 100)
Value = math.floor(Value + 0.5)
Element.Value = Value
local Percent = (Value - 1) / 99
ValueText.Text = tostring(Value)
Fill.Size = UDim2.new(Percent, 0, 1, 0)
Knob.Position = UDim2.new(Percent, 0, 0.5, 0)
if Element.Script then
local Environment = {value = Value, Value = Value, game = game, workspace = workspace, script = Element.Script}
local Function = loadstring(Element.Script)
if Function then
setfenv(Function, setmetatable(Environment, {__index = getfenv()}))
task.spawn(Function)
end
end
end

Element.Set = SetValue

local Dragging = false
local function Update(Input)
if Bar.AbsoluteSize.X <= 0 then return end
local Percent = math.clamp((Input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
SetValue(1 + (99 * Percent))
end

Bar.InputBegan:Connect(function(Input)
if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
Dragging = true
Update(Input)
end
end)

_P.Services.UserInputService.InputChanged:Connect(function(Input)
if Dragging then
if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
Update(Input)
end
end
end)

_P.Services.UserInputService.InputEnded:Connect(function(Input)
if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
Dragging = false
end
end)

function Element:SetText(Text)
self.Text = tostring(Text)
Label.Text = tostring(Text)
end

table.insert(self.Elements, Element)
table.insert(self.Window.Elements, Element)
SetValue(1)
return Element
end
