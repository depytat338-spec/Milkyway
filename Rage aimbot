        if obj.Name ~= "SpinSkin" and obj ~= player.Character then
            local n = obj.Name:lower()
            if n:find("arm") or n:find("view") or n:find("hand") or n:find("weapon") or n:find("tool") or n:find("fps") then
                pcall(function() obj:Destroy() end)
            end
        end
    end
