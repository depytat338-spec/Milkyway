function Tab:Select()
for _, Other in ipairs(self.Window.Tabs) do
Other.Page.Visible = false
_Tween(Other.Button, 0.2, {BackgroundColor3 = Settings.Background2}):Play()
Other.Button.TextColor3 = Settings.Gray
local OtherIcon = Other.Button:FindFirstChild("Icon")
if OtherIcon then
_Tween(OtherIcon, 0.2, {BackgroundTransparency = 0.5, Size = UDim2.new(0, 6, 0, 6)}):Play()
end
end
Page.Visible = true
_Tween(Button, 0.25, {BackgroundColor3 = Settings.Accent}):Play()
Button.TextColor3 = Settings.Text
_Tween(TabIcon, 0.25, {BackgroundTransparency = 0, Size = UDim2.new(0, 8, 0, 8)}):Play()
self.Window.CurrentTab = self
end

Button.MouseEnter:Connect(function()
if self.Window.CurrentTab ~= Tab then
_Tween(Button, 0.15, {BackgroundColor3 = _rgb(255, 210, 220)}):Play()
end
end)
Button.MouseLeave:Connect(function()
if self.Window.CurrentTab ~= Tab then
_Tween(Button, 0.15, {BackgroundColor3 = Settings.Background2}):Play()
end
end)

Button.MouseButton1Click:Connect(function()
Tab:Select()
end)

table.insert(self.Tabs, Tab)
if #self.Tabs == 1 then Tab:Select() end
return Tab
end

