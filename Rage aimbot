end

-- ============ ЗАГРУЗКА МОДЕЛИ ============
local function loadSkin()
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. CONFIG.SKIN_ID)
    end)

    if not ok or not result or #result == 0 then
        warn("[Skin] Не удалось загрузить " .. CONFIG.SKIN_ID)
        return nil
    end

    local model
    for _, obj in ipairs(result) do
        if obj:IsA("Model") then model = obj; break end
    end
    if not model then model = result[1] end
    if not model then return nil end

    model.Name = "SpinSkin"

    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("Script") or p:IsA("LocalScript") or p:IsA("ModuleScript") then
            pcall(function() p:Destroy() end)
        elseif p:IsA("Motor6D") or p:IsA("Weld") or p:IsA("WeldConstraint") then
            pcall(function() p:Destroy() end)
        end
    end

    if CONFIG.SKIN_SCALE ~= 1 then
        local cf, size = model:GetBoundingBox()
        local center = cf.Position
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                local rel = center - p.Position
                p.Size = p.Size * CONFIG.SKIN_SCALE
                p.Position = center - rel * CONFIG.SKIN_SCALE
            end
        end
    end

    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Massless = true
        end
    end

    local centerCFrame = model:GetBoundingBox()

    skinParts = {}
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            table.insert(skinParts, {
                part = p,
                offset = centerCFrame:ToObjectSpace(p.CFrame),
            })
        end
    end

    model.Parent = camera
    print("[Skin] Загружено: " .. model.Name)
    return model
end

