function WindowClass:SetBackground(ImageID, Transparency)
local ID = tostring(ImageID)
if not string.find(ID, "rbxassetid://", 1, true) then
ID = "rbxassetid://" .. ID
end

if self.BackgroundImage then
self.BackgroundImage.Image = ID
if Transparency ~= nil then
self.BackgroundImage.ImageTransparency = Transparency
end
end
end

function WindowClass:SetOpen(State)
State = State == true
self.Opened = State
if State then
self.Main.Visible = true
self.Shadow.Visible = true
self.Shadow2.Visible = true
self.Scale.Scale = 0.3
self.ShadowScale.Scale = 0.3
self.ShadowScale2.Scale = 0.3
_Tween(self.Scale, 0.45, {Scale = 1}, Enum.EasingStyle.Back):Play()
_Tween(self.ShadowScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back):Play()
_Tween(self.ShadowScale2, 0.5, {Scale = 1}, Enum.EasingStyle.Back):Play()
else
local T = _Tween(self.Scale, 0.3, {Scale = 0.2}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
_Tween(self.ShadowScale, 0.3, {Scale = 0.2}, Enum.EasingStyle.Quart, Enum.EasingDirection.In):Play()
_Tween(self.ShadowScale2, 0.35, {Scale = 0.2}, Enum.EasingStyle.Quart, Enum.EasingDirection.In):Play()
T:Play()
T.Completed:Once(function()
if not self.Opened then
self.Main.Visible = false
self.Shadow.Visible = false
self.Shadow2.Visible = false
end
end)
end
end

function WindowClass:Theme(themeIndex)
local theme = _P.Themes[themeIndex]
if not theme then return end
_P.Internal.CurrentTheme = themeIndex

Settings.Accent = theme.Accent
Settings.Background = theme.Background
Settings.Background2 = theme.Background2
Settings.Panel = theme.Panel
Settings.Text = theme.Text
Settings.Gray = theme.Gray
Settings.Border = theme.Border
Settings.CloseColor = theme.CloseColor

if self.Main then
self.Main.BackgroundColor3 = theme.Background
for _, child in ipairs(self.Main:GetChildren()) do
if child:IsA("UIGradient") then
child.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, _lighten(theme.Background, 5)),
ColorSequenceKeypoint.new(1, _darken(theme.Background, 8))
})
end
if child:IsA("UIStroke") then
child.Color = theme.Border
end
end
end

if self.Shadow then
self.Shadow.BackgroundColor3 = _rgb(theme.Background.R * 255 * 0.24, theme.Background.G * 255 * 0.13, theme.Background.B * 255 * 0.16)
end
if self.Shadow2 then
self.Shadow2.BackgroundColor3 = _rgb(theme.Background.R * 255 * 0.39, theme.Background.G * 255 * 0.2, theme.Background.B * 255 * 0.27)
end

local TopBar = self.Main:FindFirstChild("TopBar")
if TopBar then TopBar.BackgroundColor3 = theme.Accent end
if self.Title then self.Title.TextColor3 = theme.Text end

local Close = self.Main:FindFirstChild("Close")
if Close then Close.BackgroundColor3 = theme.CloseColor end

local Sidebar = self.Main:FindFirstChild("Sidebar")
if Sidebar then
Sidebar.BackgroundColor3 = theme.Background2
for _, child in ipairs(Sidebar:GetChildren()) do
if child:IsA("UIGradient") then
child.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, _lighten(theme.Background2, 8)),
ColorSequenceKeypoint.new(1, _darken(theme.Background2, 5))
})
end
if child:IsA("UIStroke") then child.Color = theme.Border end
if child.Name == "Separator" then
child.BackgroundColor3 = theme.Border
for _, dot in ipairs(child:GetChildren()) do
if dot.Name:find("SepDot_") then dot.BackgroundColor3 = theme.Accent end
end
end
if child.Name == "SideLine" then child.BackgroundColor3 = theme.Accent end
end
end

local Content = self.Main:FindFirstChild("Content")
if Content then
local ContentBg = Content:FindFirstChild("ContentBg")
if ContentBg then
ContentBg.BackgroundColor3 = theme.Panel
for _, child in ipairs(ContentBg:GetChildren()) do
if child:IsA("UIGradient") then
child.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, _lighten(theme.Panel, 7)),
ColorSequenceKeypoint.new(1, _darken(theme.Panel, 7))
})
end
if child:IsA("UIStroke") then child.Color = theme.Border end
end
end
end

for _, tab in ipairs(self.Tabs) do
if tab.Button then
if self.CurrentTab ~= tab then
tab.Button.BackgroundColor3 = theme.Background2
tab.Button.TextColor3 = theme.Gray
else
tab.Button.BackgroundColor3 = theme.Accent
tab.Button.TextColor3 = theme.Text
end
for _, child in ipairs(tab.Button:GetChildren()) do
if child:IsA("UIStroke") then child.Color = theme.Border end
if child.Name == "Icon" then child.BackgroundColor3 = theme.Accent end
end
end
if tab.Elements then
for _, element in ipairs(tab.Elements) do
self:UpdateElementTheme(element)
end
end
end

local ThemePage = self:FindThemePage()
if ThemePage then self:UpdateThemePage(ThemePage) end
end

function WindowClass:UpdateElementTheme(element)
if not element or not element.Object then return end
local obj = element.Object
obj.BackgroundColor3 = Settings.Panel

local function updateDescendants(parent)
for _, child in ipairs(parent:GetChildren()) do
if child:IsA("UIGradient") then
if parent.Name == "Fill" then
child.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, _lighten(Settings.Accent, 10)),
ColorSequenceKeypoint.new(1, _darken(Settings.Accent, 20))
})
else
child.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, _lighten(Settings.Panel, 8)),
ColorSequenceKeypoint.new(1, _darken(Settings.Panel, 5))
})
end
end
if child:IsA("UIStroke") then
if child.Parent and child.Parent.Name == "Knob" then
child.Color = Settings.Border
elseif child.Parent and child.Parent.Name == "Switch" then
child.Color = Settings.Border
elseif child.Parent and child.Parent.Name == "Dot" then
child.Color = Color3.fromRGB(230, 230, 230)
else
child.Color = Settings.Border
end
end
if child.Name == "Bar" then
child.BackgroundColor3 = Settings.Accent
end
if child.Name == "Fill" then
child.BackgroundColor3 = Settings.Accent
end
if child.Name == "BarBg" then
child.BackgroundColor3 = _rgb(
math.clamp(Settings.Panel.R * 255 - 15, 0, 255),
math.clamp(Settings.Panel.G * 255 - 20, 0, 255),
math.clamp(Settings.Panel.B * 255 - 14, 0, 255)
)
end
if child.Name == "Knob" then
for _, grandchild in ipairs(child:GetChildren()) do
if grandchild:IsA("UIStroke") and grandchild.Transparency == 0.7 then
grandchild.Color = Settings.Accent
end
end
end
updateDescendants(child)
end
end

updateDescendants(obj)

for _, child in ipairs(obj:GetChildren()) do
if child.Name == "AccentBar" then
if element.Value == true then
child.BackgroundColor3 = Color3.fromRGB(150, 220, 170)
else
child.BackgroundColor3 = Settings.Accent
end
end
if child.Name == "Text" then child.TextColor3 = Settings.Text end
if child.Name == "Switch" then
if element.Value == true then
child.BackgroundColor3 = Color3.fromRGB(150, 220, 170)
else
child.BackgroundColor3 = _rgb(Settings.Accent.R * 255 + 40, Settings.Accent.G * 255 + 5, Settings.Accent.B * 255 + 15)
end
end
if child.Name == "Status" then
if element.Value == true then
child.BackgroundColor3 = Color3.fromRGB(150, 220, 170)
else
child.BackgroundColor3 = Settings.CloseColor
end
end
if child.Name == "Value" then child.TextColor3 = Settings.Accent end
end
end

function WindowClass:FindThemePage()
for _, tab in ipairs(self.Tabs) do
if tab.Name == "Themes" and tab.Page then return tab.Page end
end
return nil
end

function WindowClass:UpdateThemePage(page)
for _, child in ipairs(page:GetChildren()) do
if child:IsA("TextButton") then child:Destroy() end
end

local PageLayout = page:FindFirstChildOfClass("UIListLayout")
if not PageLayout then
PageLayout = Instance.new("UIListLayout")
PageLayout.Parent = page
PageLayout.Padding = UDim.new(0, 8)
PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
end

local PagePadding = page:FindFirstChildOfClass("UIPadding")
