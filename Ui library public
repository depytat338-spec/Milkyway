TabIcon.BackgroundColor3 = Settings.Accent
TabIcon.BackgroundTransparency = 0.5
TabIcon.BorderSizePixel = 0
TabIcon.Position = UDim2.new(0, 6, 0.5, -3)
TabIcon.Size = UDim2.new(0, 6, 0, 6)
TabIcon.ZIndex = 31
_Corner(TabIcon, 3)

