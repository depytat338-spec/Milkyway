function Element:Set(Value)
Value = Value == true
local oldValue = self.Value
self.Value = Value
local offColor = _rgb(Settings.Accent.R * 255 + 40, Settings.Accent.G * 255 + 5, Settings.Accent.B * 255 + 15)

if Value then
_Tween(Switch, 0.25, {BackgroundColor3 = Color3.fromRGB(150, 220, 170)}):Play()
_Tween(Dot, 0.25, {Position = UDim2.new(0, 14, 0.5, -7)}, Enum.EasingStyle.Back):Play()
_Tween(Status, 0.25, {BackgroundColor3 = Color3.fromRGB(150, 220, 170)}):Play()
_Tween(AccentBar, 0.25, {BackgroundColor3 = Color3.fromRGB(150, 220, 170)}):Play()

if self.OnScript and oldValue ~= Value then
local Environment = {game = game, workspace = workspace, script = self.OnScript}
local Function = loadstring(self.OnScript)
if Function then
setfenv(Function, setmetatable(Environment, {__index = getfenv()}))
task.spawn(Function)
end
end
else
_Tween(Switch, 0.25, {BackgroundColor3 = offColor}):Play()
_Tween(Dot, 0.25, {Position = UDim2.new(0, 2, 0.5, -7)}, Enum.EasingStyle.Back):Play()
_Tween(Status, 0.25, {BackgroundColor3 = Settings.CloseColor}):Play()
_Tween(AccentBar, 0.25, {BackgroundColor3 = Settings.Accent}):Play()

if self.OffScript and oldValue ~= Value then
local Environment = {game = game, workspace = workspace, script = self.OffScript}
local Function = loadstring(self.OffScript)
if Function then
setfenv(Function, setmetatable(Environment, {__index = getfenv()}))
task.spawn(Function)
end
end
end
end

