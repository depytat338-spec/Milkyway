local function forceThirdPerson()
    if player.CameraMode ~= Enum.CameraMode.Classic then player.CameraMode = Enum.CameraMode.Classic end
    if player.CameraMaxZoomDistance ~= 1000 then player.CameraMaxZoomDistance = 1000 end
    if camera.CameraType ~= Enum.CameraType.Custom then camera.CameraType = Enum.CameraType.Custom end
    if currentChar then
        local hum = currentChar:FindFirstChildOfClass("Humanoid")
        if hum then
            if camera.CameraSubject ~= hum then camera.CameraSubject = hum end
            if hum.CameraOffset ~= Vector3.new(0,0,0) then hum.CameraOffset = Vector3.new(0,0,0) end
        end
    end
end

-- ============ КАМЕРА ============
local function cameraFollow(dt)
    if not currentChar or not currentChar.Parent then return end
    local hrp = currentChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local focusPos = hrp.Position + Vector3.new(0, CONFIG.Y_OFFSET, 0)
    local currentCFrame = camera.CFrame
    local rotation = currentCFrame - currentCFrame.Position
    local lookDir = currentCFrame.LookVector
    local targetPos = focusPos - lookDir * CONFIG.TARGET_DISTANCE
    local alpha = math.clamp(CONFIG.SMOOTHNESS * dt * 60, 0, 1)
    local newPos = currentCFrame.Position:Lerp(targetPos, alpha)
    camera.CFrame = CFrame.new(newPos) * rotation
end

-- ============ СПИНБОТ ============
local function spinBot(dt)
    if not currentChar or not currentChar.Parent then return end

    for _, p in ipairs(currentChar:GetDescendants()) do
        if p:IsA("BasePart") then
            if p.Transparency ~= 1 then p.Transparency = 1 end
            if p.LocalTransparencyModifier ~= 1 then p.LocalTransparencyModifier = 1 end
        elseif p:IsA("Decal") or p:IsA("Texture") then
            if p.Transparency ~= 1 then p.Transparency = 1 end
        end
    end

    spinAngle = (spinAngle + CONFIG.SPIN_SPEED * dt) % (math.pi * 2)
    local hrp = currentChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local baseCF = CFrame.new(hrp.Position + Vector3.new(0, CONFIG.SKIN_Y_OFFSET, 0)) * CFrame.Angles(0, spinAngle, 0)

    for _, data in ipairs(skinParts) do
        local p = data.part
        if p and p.Parent then
            pcall(function()
                p.CFrame = baseCF * data.offset
            end)
        end
    end
end

-- ============ АИМБОТ — ЖЁСТКАЯ ПРОВЕРКА ЖИВОСТИ ============
-- Проверяет: живой ли персонаж
local function isAlive(char)
    if not char or not char.Parent then return false end

    -- Должен быть в workspace
    if not char:IsDescendantOf(workspace) then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    -- HP > 0
    if hum.Health <= 0 then return false end

    -- Состояние Dead
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then return false end

    -- Должны быть ключевые части
    if not char:FindFirstChild("Head") then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end

    return true
end

local function isEnemy(tp)
    if not SETTINGS.CheckTeam then return true end
    local lt = player.Team
    if not lt or tp.Neutral or player.Neutral then return true end
    return tp.Team ~= lt
end

local function isValidTarget(target)
    local char = target.Character
    if not char or not char.Parent then return false end
    if target == player or char == player.Character then return false end
    if char.Name == "SpinSkin" or char:IsDescendantOf(camera) then return false end
    if target.IsPlayer and not isEnemy(target.Player) then return false end
    return isAlive(char)
end

-- Собираем всех (игроки + боты)
local function getTargets()
    local t, seen = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            table.insert(t, {Character = p.Character, IsPlayer = true, Player = p})
            seen[p.Character] = true
        end
    end

    if SETTINGS.TargetBots then
        local function scan(par)
            for _, m in ipairs(par:GetChildren()) do
                if m.Name == "SpinSkin" or m:IsDescendantOf(camera) then continue end
                if m:IsA("Model") and not seen[m] and m ~= player.Character
                   and not Players:GetPlayerFromCharacter(m) then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    local hrp = m:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        table.insert(t, {Character = m, IsPlayer = false, Player = nil})
                        seen[m] = true
                    end
                end
                if m:IsA("Folder") or m:IsA("Model") then scan(m) end
            end
        end
        scan(workspace)
    end

    return t
end

local function getPos(char)
    if not char then return nil end
    local part = char:FindFirstChild(SETTINGS.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
    return part and part.Position or nil
end

-- ✅ Ближайший живой
local function findTarget()
    local origin = camera.CFrame.Position
    local best, bestPos, bestD = nil, nil, math.huge

    for _, t in ipairs(getTargets()) do
        if isValidTarget(t) then
            local pos = getPos(t.Character)
            if pos then
                local d = (pos - origin).Magnitude
                if d <= SETTINGS.Distance and d < bestD then
                    bestD = d
                    best = t
                    bestPos = pos
                end
            end
        end
    end

    return best, bestPos
end

-- ✅ ОСНОВНОЙ ЦИКЛ АИМБОТА — мгновенное наведение камеры
local lastTarget = nil
local targetLock = 0

local function aimbotUpdate(dt)
    if not aimEnabled then return end

    local myChar = player.Character
    if not myChar or not isAlive(myChar) then return end

    local target, targetPos = findTarget()
    if not target or not targetPos then
        lastTarget = nil
        return
    end

    -- Проверяем, что цель ещё жива (двойная проверка)
    if not isValidTarget(target) then
        lastTarget = nil
        return
    end

    lastTarget = target

    -- ✅ МГНОВЕННОЕ наведение: камера смотрит на цель
    local currentCam = camera.CFrame
    local targetCam = CFrame.new(currentCam.Position, targetPos)

    if CONFIG.AIM_INSTANT then
        -- Мгновенно
        camera.CFrame = targetCam
    else
        -- Плавно
        local alpha = math.clamp(CONFIG.AIM_SMOOTHNESS * dt * 60, 0, 1)
        camera.CFrame = currentCam:Lerp(targetCam, alpha)
    end
end

